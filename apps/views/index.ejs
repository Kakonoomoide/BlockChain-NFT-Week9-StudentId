<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TicketNFT dApp</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { margin-bottom: .2rem; } .sub { color: #666; margin-top: 0; font-size: .9rem; word-break: break-all; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin: 1rem 0; }
    form { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
    input { padding: .45rem; border: 1px solid #bbb; border-radius: 6px; flex: 1; min-width: 120px; }
    button { padding: .45rem .9rem; border: 0; border-radius: 6px; background: #2b59c3; color: #fff; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    th, td { text-align: left; padding: .4rem; border-bottom: 1px solid #eee; word-break: break-all; }
    .ok { background: #e6f6ea; border: 1px solid #9ad3a8; padding: .6rem; border-radius: 6px; }
    .err { background: #fdeaea; border: 1px solid #e0a0a0; padding: .6rem; border-radius: 6px; }
    .used { color: #b00020; } .valid { color: #1b7f3b; }
  </style>
</head>
<body>
  <h1><%= info.name %> (<%= info.symbol %>)</h1>
  <p class="sub">Panitia: <%= info.organizer %><br>Wallet server: <%= info.me %><br>
    Terbit: <%= info.total %> / <%= info.maxSupply %></p>

  <% if (ok) { %><p class="ok"><%= ok %></p><% } %>
  <% if (err) { %><p class="err"><%= err %></p><% } %>

  <div class="card">
    <h3>Cetak tiket (mint)</h3>
    <form method="post" action="/mint">
      <input name="to" placeholder="Alamat penerima 0x..." required>
      <input name="eventName" placeholder="Nama event" required>
      <input name="seat" placeholder="Kursi" required>
      <button>Mint</button>
    </form>
  </div>

  <div class="card">
    <h3>Verifikasi tiket</h3>
    <form method="get" action="/verify">
      <input name="id" type="number" min="0" placeholder="ID tiket" required>
      <button>Cek</button>
    </form>
    <% if (typeof query !== 'undefined' && query) { %><% } %>
  </div>

  <div class="card">
    <h3>Daftar tiket</h3>
    <% if (tickets.length === 0) { %>
      <p>Belum ada tiket.</p>
    <% } else { %>
      <table>
        <tr><th>ID</th><th>Event</th><th>Kursi</th><th>Pemilik</th><th>Status</th><th>Aksi</th></tr>
        <% tickets.forEach(t => { %>
          <tr>
            <td><%= t.id %></td>
            <td><%= t.event %></td>
            <td><%= t.seat %></td>
            <td><%= t.owner %></td>
            <td class="<%= t.used ? 'used' : 'valid' %>"><%= t.used ? 'Terpakai' : 'Valid' %></td>
            <td>
              <% if (!t.used) { %>
                <form method="post" action="/checkin" style="display:inline">
                  <input type="hidden" name="id" value="<%= t.id %>">
                  <button>Check-in</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>

  <div class="card">
    <h3>Transfer tiket</h3>
    <form method="post" action="/transfer">
      <input name="id" type="number" min="0" placeholder="ID tiket" required>
      <input name="to" placeholder="Alamat tujuan 0x..." required>
      <button>Transfer</button>
    </form>
    <p class="sub">Hanya berhasil untuk tiket yang dimiliki wallet server.</p>
  </div>
</body>
</html>